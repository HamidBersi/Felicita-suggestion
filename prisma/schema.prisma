generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Suggestion {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       String
  label       String?
  labelColor  String   @default("orange")
  position    Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MenuCategory {
  id       String     @id @default(cuid())
  name     String
  position Int
  /** "salle" | "emporter" — deux cartes distinctes, même schéma */
  menuType String     @default("salle")
  items    MenuItem[]
  notes    MenuNote[]

  @@index([menuType])
}

/** Encadré éditorial (supplément, mention) — séparé des plats. */
model MenuNote {
  id         String       @id @default(cuid())
  title      String?
  /** Commentaire libre. Si seul (pas de titre ni de lignes), il est centré. */
  body       String       @default("")
  /** "gold" | "green" | "orange" */
  color      String       @default("gold")
  /** [{ name, price }] */
  lines      Json         @default("[]")
  position   Int
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([categoryId])
}

model MenuItem {
  id          String       @id @default(cuid())
  name        String
  description String?
  price       String
  imageUrl    String?
  isAvailable Boolean      @default(true)
  /** Temporaire : le plat reste sur la carte, affiché « En rupture ». */
  isHidden    Boolean      @default(false)
  position    Int
  /** Tarifs vin (null = format non proposé) */
  priceVerre     String?
  priceQuart     String?
  priceDemi      String?
  priceBouteille String?
  /** Pictos facultatifs devant le nom (piment, bio…) */
  emoji          String?
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
